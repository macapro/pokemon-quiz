<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#172b6d"/><stop offset=".55" stop-color="#376bdb"/><stop offset="1" stop-color="#40d5c0"/></linearGradient>
    <linearGradient id="gold" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#fff69b"/><stop offset="1" stop-color="#ffbd35"/></linearGradient>
    <filter id="shadow" x="-30%" y="-30%" width="160%" height="180%"><feGaussianBlur in="SourceAlpha" stdDeviation="8"/><feOffset dy="9"/><feComponentTransfer><feFuncA type="linear" slope=".38"/></feComponentTransfer><feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <pattern id="dots" width="34" height="34" patternUnits="userSpaceOnUse"><circle cx="3" cy="3" r="2" fill="#fff" opacity=".13"/></pattern>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"/><rect width="1200" height="630" fill="url(#dots)"/>
  <circle cx="1030" cy="132" r="150" fill="#fff" opacity=".07"/><circle cx="1000" cy="520" r="220" fill="#fff" opacity=".06"/>
  <path d="M0 525 Q180 455 360 530 T720 520 T1200 500 V630 H0Z" fill="#173d91" opacity=".44"/>
  <!-- playful quiz cards -->
  <g transform="translate(94 120) rotate(-12 93 100)" filter="url(#shadow)"><rect width="168" height="208" rx="24" fill="#fff"/><rect x="12" y="12" width="144" height="184" rx="17" fill="#eef6ff"/><text x="84" y="100" text-anchor="middle" font-family="Arial,sans-serif" font-size="66" font-weight="900" fill="#3159b8">ㅍㅋ</text><text x="84" y="151" text-anchor="middle" font-family="Arial,sans-serif" font-size="19" font-weight="700" fill="#7690c6">정답은?</text></g>
  <g transform="translate(936 306) rotate(11 83 100)" filter="url(#shadow)"><rect width="158" height="196" rx="22" fill="#fff"/><rect x="11" y="11" width="136" height="174" rx="16" fill="#fff5d9"/><text x="79" y="98" text-anchor="middle" font-family="Arial,sans-serif" font-size="62" font-weight="900" fill="#e88b13">ㅍㅋ</text><text x="79" y="146" text-anchor="middle" font-family="Arial,sans-serif" font-size="18" font-weight="700" fill="#c58c3c">맞혀봐!</text></g>
  <!-- original ball motif -->
  <g transform="translate(1016 67) rotate(18)"><circle r="62" fill="#fff"/><path d="M-62 0a62 62 0 0 1 124 0z" fill="#fa4d52"/><rect x="-62" y="-6" width="124" height="12" fill="#26314f"/><circle r="18" fill="#26314f"/><circle r="10" fill="#fff"/></g>
  <!-- mascot-like spark shapes, deliberately abstract -->
  <g transform="translate(145 437)" fill="#ffd451"><path d="M0-24 8-7 25 0 8 8 0 25-8 8-25 0-8-7Z"/><circle cx="45" cy="-26" r="6"/><circle cx="-44" cy="31" r="5"/></g>
  <g transform="translate(1067 180)" fill="#fff"><path d="M0-18 6-5 19 0 6 6 0 19-6 6-19 0-6-5Z"/><circle cx="35" cy="22" r="5"/></g>
  <!-- headline -->
  <g text-anchor="middle" font-family="'Malgun Gothic','Apple SD Gothic Neo',sans-serif" filter="url(#shadow)">
    <text x="600" y="216" font-size="40" font-weight="900" fill="#fff" letter-spacing="5">두뇌 풀가동! 포켓몬 이름 맞히기</text>
    <text x="600" y="370" font-size="108" font-weight="1000" fill="url(#gold)" stroke="#a85610" stroke-width="5" paint-order="stroke" letter-spacing="2">포켓몬</text>
    <text x="600" y="478" font-size="88" font-weight="1000" fill="#fff" stroke="#24468f" stroke-width="7" paint-order="stroke" letter-spacing="4">초성 퀴즈</text>
  </g>
  <g transform="translate(600 548)" text-anchor="middle" font-family="'Malgun Gothic','Apple SD Gothic Neo',sans-serif" font-weight="800">
    <rect x="-146" y="-27" width="292" height="54" rx="27" fill="#fff" opacity=".96"/>
    <text y="9" font-size="23" fill="#2851a5">몇 개나 맞힐 수 있을까?</text>
  </g>
  <g fill="#fff" opacity=".92"><circle cx="302" cy="146" r="5"/><circle cx="855" cy="105" r="6"/><circle cx="837" cy="519" r="4"/><circle cx="353" cy="523" r="5"/><path d="M790 173l5 12 12 5-12 5-5 12-5-12-12-5 12-5z"/></g>
</svg>
